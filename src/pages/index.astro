---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const latest = posts[0];
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<div class="intro-copy">
					<p class="eyebrow">Personal notes / 2026</p>
					<h1>把正在经历的事，<br /><em>写下来。</em></h1>
					<p class="lead">你好，我是 Chariot。这里记录技术尝试、学习笔记和生活里值得留下的片段。</p>
					<a class="text-link" href={`${base}about/`}>认识我 <span aria-hidden="true">→</span></a>
				</div>
				<div class="intro-note">
					<div class="note-mark">C</div>
					<p>在互联网的角落里，慢慢搭一座自己的小屋。</p>
					<span>blog.chariot.top</span>
				</div>
			</section>

			<section class="latest" aria-labelledby="latest-heading">
				<div class="section-heading">
					<div><p class="eyebrow">From the desk</p><h2 id="latest-heading">最近写了什么</h2></div>
					<a class="view-all" href={`${base}blog/`}>查看全部 <span aria-hidden="true">↗</span></a>
				</div>
				{latest && (
					<a class="featured" href={`${base}blog/${latest.id}/`}>
						{latest.data.heroImage && <Image width={720} height={420} src={latest.data.heroImage} alt="" />}
						<div class="featured-body">
							<div class="post-meta"><FormattedDate date={latest.data.pubDate} /> <span>·</span> 最新文章</div>
							<h3>{latest.data.title}</h3>
							<p>{latest.data.description}</p>
							<span class="read-more">阅读全文 <span aria-hidden="true">→</span></span>
						</div>
					</a>
				)}
				<div class="post-list">
					{posts.slice(1, 4).map((post) => (
						<a class="post-row" href={`${base}blog/${post.id}/`}>
							<div><p class="post-meta"><FormattedDate date={post.data.pubDate} /></p><h3>{post.data.title}</h3></div>
							<span class="row-arrow" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro { display: grid; grid-template-columns: minmax(0, 1fr) 300px; align-items: end; gap: 80px; min-height: 430px; padding: 40px 0 88px; border-bottom: 1px solid var(--line); }
	.intro-copy { min-width: 0; }
	.intro h1 { font-size: clamp(2.8rem, 6vw, 5.4rem); letter-spacing: 0; }
	.intro h1 em { color: var(--accent); font-family: Georgia, serif; font-weight: 400; }
	.lead { max-width: 550px; margin: 26px 0 24px; color: var(--muted); font-size: 1.1rem; }
	.text-link, .view-all, .read-more { color: var(--ink); font-weight: 700; text-decoration: none; }
	.text-link:hover, .view-all:hover, .read-more:hover { color: var(--accent); }
	.text-link span, .view-all span, .read-more span { display: inline-block; margin-left: 5px; transition: transform 160ms ease; }
	.text-link:hover span, .view-all:hover span, .read-more:hover span { transform: translateX(4px); }
	.intro-note { padding: 24px; border-top: 2px solid var(--ink); background: var(--surface); }
	.note-mark { display: grid; width: 48px; height: 48px; margin-bottom: 42px; place-items: center; background: var(--accent); color: white; font-family: Georgia, serif; font-size: 1.5rem; }
	.intro-note p { margin-bottom: 18px; font-family: Georgia, "Microsoft YaHei", serif; font-size: 1.2rem; line-height: 1.5; }
	.intro-note span { color: var(--muted); font-size: .8rem; }
	.latest { padding-top: 74px; }
	.section-heading { display: flex; align-items: end; justify-content: space-between; margin-bottom: 26px; }
	.section-heading .eyebrow { margin-bottom: 8px; }
	.section-heading h2 { font-size: 2.1rem; }
	.view-all { margin-bottom: 7px; color: var(--muted); font-size: .9rem; }
	.featured { display: grid; grid-template-columns: 42% 1fr; min-height: 310px; border: 1px solid var(--line); color: inherit; text-decoration: none; transition: box-shadow 180ms ease, transform 180ms ease; }
	.featured:hover { box-shadow: var(--box-shadow); transform: translateY(-3px); }
	.featured img { width: 100%; height: 100%; min-height: 310px; object-fit: cover; }
	.featured-body { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 42px; }
	.post-meta { margin: 0 0 14px; color: var(--accent); font-size: .78rem; font-weight: 700; letter-spacing: 0; text-transform: uppercase; }
	.post-meta span { padding: 0 5px; color: var(--muted); }
	.featured h3 { max-width: 520px; font-size: 2rem; }
	.featured-body p { max-width: 500px; color: var(--muted); }
	.read-more { margin-top: 14px; font-size: .9rem; }
	.post-list { margin-top: 16px; }
	.post-row { display: flex; align-items: center; justify-content: space-between; padding: 22px 8px; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
	.post-row:hover { padding-left: 14px; background: var(--surface); }
	.post-row h3 { margin: 0; font-size: 1.22rem; }
	.post-row .post-meta { margin-bottom: 3px; color: var(--muted); font-size: .75rem; }
	.row-arrow { color: var(--accent); font-size: 1.3rem; }
	@media (max-width: 720px) {
		.intro { grid-template-columns: 1fr; gap: 36px; min-height: 0; padding: 24px 0 56px; }
		.intro h1 { font-size: 2.5rem; }
		.intro-note { width: 100%; max-width: 380px; }
		.latest { padding-top: 52px; }
		.section-heading h2 { font-size: 1.75rem; }
		.featured { grid-template-columns: 1fr; }
		.featured img { min-height: 190px; max-height: 220px; }
		.featured-body { padding: 28px 24px; }
		.featured h3 { font-size: 1.55rem; }
	}
	@media (max-width: 380px) {
		.intro h1 { font-size: 2.25rem; }
	}
</style>
