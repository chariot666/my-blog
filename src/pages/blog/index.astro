---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title="文章 | Chariot" description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<div><p class="eyebrow">Archive / {posts.length} posts</p><h1>所有文章</h1></div>
				<p>技术、学习和生活的长期记录。</p>
			</header>
			<section class="posts">
				{posts.length > 0 ? posts.map((post, index) => (
					<a class="post" href={`${base}blog/${post.id}/`}>
						<div class="post-number">{String(index + 1).padStart(2, '0')}</div>
						<div class="post-copy">
							<div class="date"><FormattedDate date={post.data.pubDate} /></div>
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
						</div>
						{post.data.heroImage && <Image width={260} height={150} src={post.data.heroImage} alt="" />}
						<span class="arrow" aria-hidden="true">↗</span>
					</a>
				)) : (
					<div class="empty-state"><span>00</span><div><h2>还没有文章</h2><p>第一篇内容发布后，会出现在这里。</p></div></div>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head { display: flex; align-items: end; justify-content: space-between; margin-bottom: 54px; padding: 40px 0 46px; border-bottom: 1px solid var(--line); }
	.page-head h1 { margin: 0; font-size: 3.4rem; }
	.page-head > p { max-width: 280px; margin: 0 0 8px; color: var(--muted); text-align: right; }
	.posts { border-top: 2px solid var(--ink); }
	.empty-state { display: flex; align-items: center; gap: 28px; min-height: 220px; padding: 40px 8px; border-bottom: 1px solid var(--line); }
	.empty-state > span { color: var(--accent); font-family: Georgia, serif; }
	.empty-state h2 { margin-bottom: 6px; font-size: 1.55rem; }
	.empty-state p { margin: 0; color: var(--muted); }
	.post { display: grid; grid-template-columns: 54px minmax(0, 1fr) 220px 28px; align-items: center; gap: 28px; min-height: 190px; padding: 24px 8px; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; transition: background 160ms ease, padding 160ms ease; }
	.post:hover { padding-right: 14px; padding-left: 14px; background: var(--surface); }
	.post-number { align-self: start; padding-top: 3px; color: var(--accent); font-family: Georgia, serif; }
	.date { margin-bottom: 8px; color: var(--muted); font-size: .78rem; }
	.post h2 { margin-bottom: 8px; font-size: 1.55rem; }
	.post p { max-width: 560px; margin: 0; color: var(--muted); font-size: .94rem; }
	.post img { width: 220px; height: 128px; object-fit: cover; }
	.arrow { color: var(--accent); font-size: 1.3rem; }
	@media (max-width: 760px) {
		.page-head { align-items: flex-start; flex-direction: column; gap: 16px; padding-top: 20px; }
		.page-head h1 { font-size: 2.5rem; }
		.page-head > p { text-align: left; }
		.post { grid-template-columns: 34px 1fr 22px; gap: 14px; min-height: 150px; }
		.post img { display: none; }
		.post h2 { font-size: 1.3rem; }
		.empty-state { gap: 18px; min-height: 180px; }
	}
</style>
