---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<header class="site-header">
	<nav aria-label="主导航">
		<a class="brand" href={base} aria-label={`${SITE_TITLE} 首页`}><span class="brand-mark">C</span><span>{SITE_TITLE}</span></a>
		<div class="internal-links">
			<HeaderLink href={base}>首页</HeaderLink>
			<HeaderLink href={`${base}blog/`}>文章</HeaderLink>
			<HeaderLink href={`${base}about/`}>关于</HeaderLink>
		</div>
		<a class="github-link" href="https://github.com/chariot666" target="_blank" rel="noreferrer" aria-label="访问 Chariot 的 GitHub">
			<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"><path fill="currentColor" d="M12 .7a11.3 11.3 0 0 0-3.57 22c.57.1.77-.25.77-.55v-2.19c-3.15.68-3.81-1.34-3.81-1.34-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.74 2.66 1.24 3.31.95.1-.73.4-1.24.72-1.53-2.51-.29-5.15-1.26-5.15-5.59 0-1.24.44-2.25 1.17-3.04-.12-.29-.51-1.44.11-3 0 0 .95-.3 3.11 1.16a10.8 10.8 0 0 1 5.66 0C17.04 4.7 18 5 18 5c.62 1.56.23 2.71.11 3 .73.79 1.17 1.8 1.17 3.04 0 4.34-2.65 5.3-5.17 5.58.41.35.77 1.04.77 2.1v3.12c0 .3.21.66.78.55A11.3 11.3 0 0 0 12 .7Z"/></svg>
		</a>
	</nav>
</header>
<style>
	.site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid rgba(231,231,229,.9); background: rgba(255,255,255,.92); backdrop-filter: blur(14px); }
	nav { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; width: min(1120px, calc(100% - 40px)); height: 68px; margin: 0 auto; }
	.brand { display: inline-flex; align-items: center; gap: 10px; width: fit-content; color: var(--ink); font-size: 1rem; font-weight: 700; text-decoration: none; }
	.brand-mark { display: grid; width: 30px; height: 30px; place-items: center; background: var(--ink); color: white; font-family: Georgia, serif; font-size: 1rem; }
	.internal-links { display: flex; align-self: stretch; gap: 30px; }
	.internal-links :global(a) { position: relative; display: grid; place-items: center; color: var(--muted); font-size: .9rem; text-decoration: none; }
	.internal-links :global(a::after) { position: absolute; bottom: -1px; left: 0; width: 100%; height: 2px; background: transparent; content: ""; }
	.internal-links :global(a:hover), .internal-links :global(a.active) { color: var(--ink); }
	.internal-links :global(a.active::after) { background: var(--accent); }
	.github-link { display: grid; width: 38px; height: 38px; margin-left: auto; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--ink); text-decoration: none; transition: border-color 160ms ease, color 160ms ease; }
	.github-link:hover { border-color: var(--ink); color: var(--accent); }
	@media (max-width: 620px) {
		nav { grid-template-columns: auto 1fr auto; width: calc(100% - 28px); max-width: 1120px; }
		.brand > span:last-child { display: none; }
		.internal-links { justify-content: center; gap: 18px; }
	}
</style>
