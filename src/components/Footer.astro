---
const today = new Date();
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<footer>
	<div class="footer-inner">
		<div><strong>Chariot</strong><p>记录技术、学习与生活。</p></div>
		<div class="footer-meta"><a href={`${base}rss.xml`}>RSS</a><a href="https://github.com/chariot666" target="_blank" rel="noreferrer">GitHub</a><span>&copy; {today.getFullYear()}</span></div>
	</div>
</footer>
<style>
	footer { border-top: 1px solid var(--line); background: var(--surface); }
	.footer-inner { display: flex; align-items: center; justify-content: space-between; width: min(1120px, calc(100% - 40px)); min-height: 150px; margin: 0 auto; color: var(--muted); }
	strong { color: var(--ink); }
	p { margin: 4px 0 0; font-size: .9rem; }
	.footer-meta { display: flex; align-items: center; gap: 22px; font-size: .85rem; }
	a { color: var(--muted); text-decoration: none; }
	a:hover { color: var(--accent); }
	@media (max-width: 620px) { .footer-inner { align-items: flex-start; flex-direction: column; justify-content: center; gap: 22px; width: calc(100% - 28px); } }
</style>
